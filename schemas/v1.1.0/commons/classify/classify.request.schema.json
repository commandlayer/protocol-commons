{
  "$id": "https://commandlayer.org/schemas/v1.1.0/commons/classify/classify.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "classify.request",
  "description": "Request to classify caller-supplied input into categories.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verb": {
      "type": "string",
      "const": "classify"
    },
    "version": {
      "type": "string",
      "const": "1.1.0"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "multi",
        "hierarchical"
      ]
    }
  },
  "required": [
    "verb",
    "version",
    "input"
  ]
}

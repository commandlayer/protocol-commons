{
  "$id": "https://commandlayer.org/schemas/v1.1.0/commons/analyze/analyze.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analyze.request",
  "description": "Request to analyze caller-supplied input.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verb": {
      "type": "string",
      "const": "analyze"
    },
    "version": {
      "type": "string",
      "const": "1.1.0"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "classify",
        "extract",
        "score",
        "summarize"
      ]
    }
  },
  "required": [
    "verb",
    "version",
    "input"
  ]
}
